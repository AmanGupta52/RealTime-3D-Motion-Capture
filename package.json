{
  "name": "mocap-studio",
  "private": true,
  "version": "1.0.5",
  "description": "Real-time webcam 3D motion capture desktop app",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/scan-models.mjs && vite",
    "build": "node scripts/scan-models.mjs && tsc --noEmit && vite build",
    "test": "vitest run",
    "setup:assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs",
    "desktop": "node scripts/scan-models.mjs && vite build && electron .",
    "desktop:dev": "node scripts/scan-models.mjs && concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV=1 electron .\"",
    "package": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "scan:models": "node scripts/scan-models.mjs"
  },
  "build": {
    "appId": "com.mocapstudio.app",
    "productName": "Mocap Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSCameraUsageDescription": "Mocap Studio needs your camera to track your movement."
      }
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "zustand": "5.0.2",
    "fflate": "0.8.2",
    "@pixiv/three-vrm": "3.3.3"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "wait-on": "8.0.1"
  }
}
